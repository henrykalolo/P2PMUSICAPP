# Copy to .env.local and replace EVERY placeholder before starting the app.

# Database (required)
DATABASE_URL=postgresql://musicapp:CHANGE_ME@localhost:5432/musicapp

# Security (required)
# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Separate 32-byte key for AES-256-GCM encryption at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Local object store (optional override). Files are encrypted at rest.
STORAGE_DIR=./uploads

# WebAuthn (optional)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="P2P Music Platform"
WEBAUTHN_ORIGIN=http://localhost:3000

# Upload limits
MAX_FILE_SIZE=104857600
DAILY_UPLOAD_QUOTA=104857600
TOTAL_UPLOAD_QUOTA=10737418240
