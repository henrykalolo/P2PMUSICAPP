# Database
DATABASE_URL=postgresql://user:password@localhost:5432/musicapp
REDIS_URL=redis://localhost:6379

# Security
ENCRYPTION_KEY_SALT=your-random-32-byte-hex-here
JWT_SECRET=your-random-64-byte-hex-here
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="P2P Music Platform"
WEBAUTHN_ORIGIN=http://localhost:3000

# P2P
TRACKER_URL=ws://localhost:8000
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.example.com:3478
TURN_USERNAME=username
TURN_PASSWORD=password

# IPFS
IPFS_GATEWAY_URL=https://ipfs.io
IPFS_LOCAL_GATEWAY=http://localhost:8080
IPFS_DEBUG=false
IPFS_ENABLE_PUBSUB=true
IPFS_BOOTSTRAP_NODES=/dnsaddr/bootstrap.libp2p.io/p2p/QmNnooDu7bfjPFoTZYxMNLWUQJyrVwtbZg5gBMjTezGAJN,/dnsaddr/bootstrap.libp2p.io/p2p/QmQCU2EcMqAqQPR2i9bChDtGNJchTbq5TbXJJ16u19uLTa

# Feature Flags
ENABLE_P2P=true
ENABLE_BACKGROUND_SEEDING=true
ENABLE_ANALYTICS=false

# Upload Limits
MAX_FILE_SIZE=104857600
DAILY_UPLOAD_QUOTA=104857600
TOTAL_UPLOAD_QUOTA=10737418240
